<!--
  導航任務場景：Go1（只有腳有碰撞）+ 平地 + 8 個障礙物 + 1 個目標點。
  障礙物和目標都是 mocap body（位置在程式裡每回合重新擺），
  contype/conaffinity = 0 代表不參與物理碰撞，只用來顯示；
  「撞到」由程式用幾何距離判斷，雷射距離也由程式解析計算。
-->
<mujoco model="go1 navigation scene">
  <include file="go1_mjx_feetonly.xml"/>

  <statistic center="0 0 0.1" extent="0.8" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-35" offwidth="3840" offheight="2160"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
    <material name="obstacle" rgba="0.85 0.35 0.2 1"/>
    <material name="goal" rgba="0.1 0.8 0.3 0.6"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="0" priority="1"
      friction="0.6" condim="3"/>
    <camera name="overview" pos="0 -7 9" xyaxes="1 0 0 0 0.79 0.61"/>

    <body name="obstacle0" mocap="true" pos="100 100 0.4"><geom type="cylinder" size="0.4 0.4" material="obstacle" contype="0" conaffinity="0"/></body>
    <body name="obstacle1" mocap="true" pos="100 100 0.4"><geom type="cylinder" size="0.4 0.4" material="obstacle" contype="0" conaffinity="0"/></body>
    <body name="obstacle2" mocap="true" pos="100 100 0.4"><geom type="cylinder" size="0.4 0.4" material="obstacle" contype="0" conaffinity="0"/></body>
    <body name="obstacle3" mocap="true" pos="100 100 0.4"><geom type="cylinder" size="0.4 0.4" material="obstacle" contype="0" conaffinity="0"/></body>
    <body name="obstacle4" mocap="true" pos="100 100 0.4"><geom type="cylinder" size="0.4 0.4" material="obstacle" contype="0" conaffinity="0"/></body>
    <body name="obstacle5" mocap="true" pos="100 100 0.4"><geom type="cylinder" size="0.4 0.4" material="obstacle" contype="0" conaffinity="0"/></body>
    <body name="obstacle6" mocap="true" pos="100 100 0.4"><geom type="cylinder" size="0.4 0.4" material="obstacle" contype="0" conaffinity="0"/></body>
    <body name="obstacle7" mocap="true" pos="100 100 0.4"><geom type="cylinder" size="0.4 0.4" material="obstacle" contype="0" conaffinity="0"/></body>
    <body name="goal" mocap="true" pos="3 0 0.05"><geom type="cylinder" size="0.3 0.02" material="goal" contype="0" conaffinity="0"/></body>
  </worldbody>

  <include file="sensor_feet.xml"/>

  <keyframe>
    <key name="home" qpos="
    0 0 0.278
    1 0 0 0
    0.1 0.9 -1.8
    -0.1 0.9 -1.8
    0.1 0.9 -1.8
    -0.1 0.9 -1.8"
      ctrl="0.1 0.9 -1.8 -0.1 0.9 -1.8 0.1 0.9 -1.8 -0.1 0.9 -1.8"/>
  </keyframe>
</mujoco>
